<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar icon (spec section 26 reminders). Android renders this as a
    flat white silhouette from the alpha channel alone, so it is drawn as a
    single bold solid-white glyph — the same checkmark motif as the launcher
    icon, simplified for legibility at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,13 L10,18 L19,7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
